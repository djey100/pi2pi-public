# pi2pi frontend — build-time network selection (non-secret).
# Loaded automatically by `vite build` (production mode). See arc/src/helpers.js
# for how this is resolved. Note: `vite build` itself is a bundler/transpiler
# and never executes application code, so it cannot fail on a bad value here.
# An unrecognized or missing VITE_NETWORK instead fails the app closed at
# module evaluation/runtime — i.e. when the built bundle is actually loaded
# (in a browser, or by any test/Node context that executes it) — rather than
# silently falling back to any other network.
VITE_NETWORK=arc-testnet
