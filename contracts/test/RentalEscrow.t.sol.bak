    // ═════════════════════════════════════════════════════════════════════════════
    //  19. ESCROW BALANCE INVARIANTS
    // ═════════════════════════════════════════════════════════════════════════════

    function test_escrowBalance_afterActivation() public {
        uint256 id = _activateAgreement();
        // Escrow holds: commitment + hosting + prop deposit (first rent already sent to landlord)
        uint256 expected = MR + MR + PROP_DEP;
        assertEq(usdc.balanceOf(address(escrow)), expected);
    }

    function test_escrowBalance_zeroAfterCleanCheckout() public {
        uint256 id = _activateAgreement();
        _advanceToCheckout(id);

        vm.prank(landlord);
        escrow.confirmNoDamage(id);

        assertEq(usdc.balanceOf(address(escrow)), 0);
    }

    function test_escrowBalance_zeroAfterDisputeRelease() public {
        uint256 id = _activateAgreement();
        uint256 claimAmt = 3000e6;
        _openDispute(id, claimAmt);

        vm.warp(block.timestamp + 60 days);
        escrow.releaseFrozenFunds(id);

        assertEq(usdc.balanceOf(address(escrow)), 0);
    }

