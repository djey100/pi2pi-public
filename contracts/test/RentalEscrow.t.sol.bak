// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import {Test, console2} from "forge-std/Test.sol";
import {RentalEscrow} from "../src/RentalEscrow.sol";
import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";

/// @dev Minimal ERC-20 mock for USDC (6 decimals)
contract MockUSDC is ERC20 {
    constructor() ERC20("Mock USDC", "USDC") {}

    function decimals() public pure override returns (uint8) {
        return 6;
    }

    function mint(address to, uint256 amount) external {
        _mint(to, amount);
    }
}

/// @title RentalEscrow comprehensive test suite
/// @notice Covers all 9 states, deposit mechanics, checkout, damage claims,
///         dispute bond + 60-day freeze, early termination (3 paths), and timeout mechanics.
contract RentalEscrowTest is Test {
    RentalEscrow public escrow;
    MockUSDC public usdc;

    address tenant = makeAddr("tenant");
    address landlord = makeAddr("landlord");
    address treasury = makeAddr("treasury");
    address stranger = makeAddr("stranger");

    uint256 constant MR = 2500e6; // 2500 USDC
    uint256 constant PROP_DEP = 5000e6; // 2× MR
    uint256 constant LEASE_MONTHS = 6;
    bytes32 constant CONTENT_HASH = keccak256("ipfs://QmAgreementHash");

    // ─── Setup ───────────────────────────────────────────────────────────────────

    function setUp() public {
        usdc = new MockUSDC();
        escrow = new RentalEscrow(address(usdc), treasury);

        // Fund parties generously
        usdc.mint(tenant, 100_000e6);
        usdc.mint(landlord, 100_000e6);

        // Approve escrow
        vm.prank(tenant);
        usdc.approve(address(escrow), type(uint256).max);
        vm.prank(landlord);
        usdc.approve(address(escrow), type(uint256).max);
    }

    // ─── Helpers ─────────────────────────────────────────────────────────────────

    function _createAgreement() internal returns (uint256 id) {
        id = escrow.createAgreement(tenant, landlord, MR, PROP_DEP, LEASE_MONTHS, CONTENT_HASH);
    }

    function _createAgreementNoPropDep() internal returns (uint256 id) {
        id = escrow.createAgreement(tenant, landlord, MR, 0, LEASE_MONTHS, CONTENT_HASH);
    }

    /// @dev Creates agreement and deposits from both parties, reaching Active state.
    function _activateAgreement() internal returns (uint256 id) {
        id = _createAgreement();
        vm.prank(tenant);
        escrow.tenantDeposit(id);
        vm.prank(landlord);
        escrow.landlordDeposit(id);
    }

    function _activateAgreementNoPropDep() internal returns (uint256 id) {
        id = _createAgreementNoPropDep();
        vm.prank(tenant);
        escrow.tenantDeposit(id);
        vm.prank(landlord);
        escrow.landlordDeposit(id);
    }

    /// @dev Fast-forward to renewal voting window (last 30 days of lease).
    function _warpToRenewalWindow(uint256 id) internal {
        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        vm.warp(a.leaseEndTime - 29 days);
    }

    /// @dev Both vote to end -> CheckoutProposed.
    function _advanceToCheckout(uint256 id) internal {
        _warpToRenewalWindow(id);
        vm.prank(landlord);
        escrow.voteRenewal(id, false);
        vm.prank(tenant);
        escrow.voteRenewal(id, false);
    }

    /// @dev File a damage claim and get to DamageClaimed state.
    function _advanceToDamageClaimed(uint256 id, uint256 claimAmt) internal {
        _advanceToCheckout(id);
        vm.prank(landlord);
        escrow.fileDamageClaim(id, claimAmt);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  1. AGREEMENT CREATION
    // ═════════════════════════════════════════════════════════════════════════════

    function test_createAgreement() public {
        uint256 id = _createAgreement();

        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(a.tenant, tenant);
        assertEq(a.landlord, landlord);
        assertEq(a.monthlyRent, MR);
        assertEq(a.commitmentDeposit, MR);
        assertEq(a.hostingDeposit, MR);
        assertEq(a.propSecurityDeposit, PROP_DEP);
        assertEq(a.leaseDurationMonths, LEASE_MONTHS);
        assertEq(uint8(a.state), uint8(RentalEscrow.State.Created));
        assertEq(a.freezeDuration, 60 days);
    }

    function test_createAgreement_incrementsId() public {
        uint256 id0 = _createAgreement();
        uint256 id1 = _createAgreement();
        assertEq(id0, 0);
        assertEq(id1, 1);
    }

    function test_createAgreement_revert_zeroAddress() public {
        vm.expectRevert("Zero address");
        escrow.createAgreement(address(0), landlord, MR, 0, LEASE_MONTHS, CONTENT_HASH);
    }

    function test_createAgreement_revert_sameAddress() public {
        vm.expectRevert("Same address");
        escrow.createAgreement(tenant, tenant, MR, 0, LEASE_MONTHS, CONTENT_HASH);
    }

    function test_createAgreement_revert_zeroRent() public {
        vm.expectRevert("Zero rent");
        escrow.createAgreement(tenant, landlord, 0, 0, LEASE_MONTHS, CONTENT_HASH);
    }

    function test_createAgreement_revert_propDepTooHigh() public {
        vm.expectRevert("Prop deposit > 3x MR");
        escrow.createAgreement(tenant, landlord, MR, MR * 4, LEASE_MONTHS, CONTENT_HASH);
    }

    function test_createAgreement_maxPropDeposit() public {
        uint256 id = escrow.createAgreement(tenant, landlord, MR, MR * 3, LEASE_MONTHS, CONTENT_HASH);
        assertEq(escrow.getAgreement(id).propSecurityDeposit, MR * 3);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  2. DEPOSIT PLACEMENT & ACTIVATION
    // ═════════════════════════════════════════════════════════════════════════════

    function test_tenantDepositsFirst_awaitingLandlord() public {
        uint256 id = _createAgreement();

        uint256 balBefore = usdc.balanceOf(tenant);
        vm.prank(tenant);
        escrow.tenantDeposit(id);

        uint256 expectedTransfer = MR + MR + PROP_DEP; // rent + commitment + prop
        assertEq(usdc.balanceOf(tenant), balBefore - expectedTransfer);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.AwaitingLandlordDep));
    }

    function test_landlordDepositsFirst_awaitingTenant() public {
        uint256 id = _createAgreement();

        vm.prank(landlord);
        escrow.landlordDeposit(id);

        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.AwaitingTenantDep));
    }

    function test_bothDeposit_activates() public {
        uint256 id = _activateAgreement();

        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(uint8(a.state), uint8(RentalEscrow.State.Active));
        assertGt(a.activatedAt, 0);
        assertEq(a.leaseEndTime, a.activatedAt + LEASE_MONTHS * 30 days);
        assertTrue(a.tenantDeposited);
        assertTrue(a.landlordDeposited);
        assertTrue(a.firstRentPaid);
    }

    function test_activation_sendsFirstRentToLandlord() public {
        uint256 id = _createAgreement();

        vm.prank(tenant);
        escrow.tenantDeposit(id);

        uint256 llBalBefore = usdc.balanceOf(landlord);
        vm.prank(landlord);
        escrow.landlordDeposit(id);

        // Landlord paid MR hosting but received MR first rent -> net 0 change
        assertEq(usdc.balanceOf(landlord), llBalBefore - MR + MR);
    }

    function test_activation_reverseOrder() public {
        uint256 id = _createAgreement();

        // Landlord first, then tenant
        vm.prank(landlord);
        escrow.landlordDeposit(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.AwaitingTenantDep));

        vm.prank(tenant);
        escrow.tenantDeposit(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Active));
    }

    function test_deposit_revert_doubleDeposit() public {
        uint256 id = _createAgreement();
        vm.prank(tenant);
        escrow.tenantDeposit(id);

        // State is now AwaitingLandlordDep - tenant deposit call fails on state check
        vm.prank(tenant);
        vm.expectRevert("Wrong state for tenant deposit");
        escrow.tenantDeposit(id);
    }

    function test_deposit_revert_wrongParty() public {
        uint256 id = _createAgreement();
        vm.prank(stranger);
        vm.expectRevert("Not tenant");
        escrow.tenantDeposit(id);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  3. RENT PAYMENTS
    // ═════════════════════════════════════════════════════════════════════════════

    function test_payRent_success() public {
        uint256 id = _activateAgreement();

        vm.warp(block.timestamp + 30 days);
        uint256 llBal = usdc.balanceOf(landlord);

        vm.prank(tenant);
        escrow.payRent(id);

        assertEq(usdc.balanceOf(landlord), llBal + MR);
        assertEq(escrow.getAgreement(id).rentPaymentsMade, 1);
    }

    function test_payRent_revert_leaseExpired() public {
        uint256 id = _activateAgreement();
        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        vm.warp(a.leaseEndTime + 1);

        vm.prank(tenant);
        vm.expectRevert("Lease expired");
        escrow.payRent(id);
    }

    function test_payRent_revert_notTenant() public {
        uint256 id = _activateAgreement();
        vm.warp(block.timestamp + 30 days);

        vm.prank(landlord);
        vm.expectRevert("Not tenant");
        escrow.payRent(id);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  4. RENT MISSED - KEEPER TIMEOUT
    // ═════════════════════════════════════════════════════════════════════════════

    function test_flagRentMissed_afterGracePeriod() public {
        uint256 id = _activateAgreement();

        // Warp past 30 days + 5 day grace
        vm.warp(block.timestamp + 35 days + 1);

        uint256 llBal = usdc.balanceOf(landlord);
        uint256 tnBal = usdc.balanceOf(tenant);

        escrow.flagRentMissed(id);

        // Landlord gets commitment + hosting deposits
        assertEq(usdc.balanceOf(landlord), llBal + MR + MR);
        // Tenant gets prop deposit back
        assertEq(usdc.balanceOf(tenant), tnBal + PROP_DEP);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_flagRentMissed_noPropDep() public {
        uint256 id = _activateAgreementNoPropDep();
        vm.warp(block.timestamp + 35 days + 1);

        uint256 llBal = usdc.balanceOf(landlord);
        escrow.flagRentMissed(id);

        assertEq(usdc.balanceOf(landlord), llBal + MR + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_flagRentMissed_revert_tooEarly() public {
        uint256 id = _activateAgreement();
        vm.warp(block.timestamp + 34 days);

        vm.expectRevert("Not overdue yet");
        escrow.flagRentMissed(id);
    }

    function test_flagRentMissed_revert_afterRecentPayment() public {
        uint256 id = _activateAgreement();
        vm.warp(block.timestamp + 30 days);

        vm.prank(tenant);
        escrow.payRent(id);

        // Only 5 days after payment - not overdue
        vm.warp(block.timestamp + 5 days);
        vm.expectRevert("Not overdue yet");
        escrow.flagRentMissed(id);
    }

    function test_isRentOverdue_view() public {
        uint256 id = _activateAgreement();
        assertFalse(escrow.isRentOverdue(id));

        vm.warp(block.timestamp + 35 days + 1);
        assertTrue(escrow.isRentOverdue(id));
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  5. RENEWAL VOTING
    // ═════════════════════════════════════════════════════════════════════════════

    function test_renewal_bothAgree_extends() public {
        uint256 id = _activateAgreement();
        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        uint256 originalEnd = a.leaseEndTime;

        _warpToRenewalWindow(id);

        vm.prank(landlord);
        escrow.voteRenewal(id, true);
        // Still Active, waiting for tenant
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Active));

        vm.prank(tenant);
        escrow.voteRenewal(id, true);

        a = escrow.getAgreement(id);
        assertEq(uint8(a.state), uint8(RentalEscrow.State.Active));
        assertEq(a.leaseEndTime, originalEnd + LEASE_MONTHS * 30 days);
        // Votes reset
        assertFalse(a.landlordVoted);
        assertFalse(a.tenantVoted);
    }

    function test_renewal_oneDeclines_checkout() public {
        uint256 id = _activateAgreement();
        _warpToRenewalWindow(id);

        vm.prank(landlord);
        escrow.voteRenewal(id, true);
        vm.prank(tenant);
        escrow.voteRenewal(id, false);

        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.CheckoutProposed));
    }

    function test_renewal_bothDecline_checkout() public {
        uint256 id = _activateAgreement();
        _advanceToCheckout(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.CheckoutProposed));
    }

    function test_renewal_revert_tooEarly() public {
        uint256 id = _activateAgreement();
        // Don't warp - still too early
        vm.prank(landlord);
        vm.expectRevert("Too early for renewal vote");
        escrow.voteRenewal(id, true);
    }

    function test_renewal_revert_stranger() public {
        uint256 id = _activateAgreement();
        _warpToRenewalWindow(id);
        vm.prank(stranger);
        vm.expectRevert("Not a party");
        escrow.voteRenewal(id, true);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  6. CHECKOUT - CLEAN (NO DAMAGE)
    // ═════════════════════════════════════════════════════════════════════════════

    function test_confirmNoDamage_settles() public {
        uint256 id = _activateAgreement();
        _advanceToCheckout(id);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        vm.prank(landlord);
        escrow.confirmNoDamage(id);

        // Tenant gets: prop deposit + commitment deposit
        assertEq(usdc.balanceOf(tenant), tnBal + PROP_DEP + MR);
        // Landlord gets: hosting deposit
        assertEq(usdc.balanceOf(landlord), llBal + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_confirmNoDamage_noPropDep() public {
        uint256 id = _activateAgreementNoPropDep();
        _advanceToCheckout(id);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        vm.prank(landlord);
        escrow.confirmNoDamage(id);

        assertEq(usdc.balanceOf(tenant), tnBal + MR);
        assertEq(usdc.balanceOf(landlord), llBal + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_confirmNoDamage_revert_notLandlord() public {
        uint256 id = _activateAgreement();
        _advanceToCheckout(id);

        vm.prank(tenant);
        vm.expectRevert("Not landlord");
        escrow.confirmNoDamage(id);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  7. DAMAGE CLAIM - ACCEPT
    // ═════════════════════════════════════════════════════════════════════════════

    function test_fileDamageClaim() public {
        uint256 id = _activateAgreement();
        _advanceToCheckout(id);

        uint256 claimAmt = PROP_DEP * 60 / 100; // 60%
        vm.prank(landlord);
        escrow.fileDamageClaim(id, claimAmt);

        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(uint8(a.state), uint8(RentalEscrow.State.DamageClaimed));
        assertEq(a.damageClaim, claimAmt);
        assertEq(a.damageClaimDeadline, block.timestamp + 3 days);
    }

    function test_fileDamageClaim_revert_noPropDep() public {
        uint256 id = _activateAgreementNoPropDep();
        _advanceToCheckout(id);

        vm.prank(landlord);
        vm.expectRevert("No prop deposit");
        escrow.fileDamageClaim(id, 1000e6);
    }

    function test_fileDamageClaim_revert_tooHigh() public {
        uint256 id = _activateAgreement();
        _advanceToCheckout(id);

        vm.prank(landlord);
        vm.expectRevert("Invalid claim amount");
        escrow.fileDamageClaim(id, PROP_DEP + 1);
    }

    function test_acceptDamageClaim_distributes() public {
        uint256 id = _activateAgreement();
        uint256 claimAmt = 3000e6;
        _advanceToDamageClaimed(id, claimAmt);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        vm.prank(tenant);
        escrow.acceptDamageClaim(id);

        // Landlord: claim amount + hosting deposit
        assertEq(usdc.balanceOf(landlord), llBal + claimAmt + MR);
        // Tenant: remainder of prop dep + commitment deposit
        assertEq(usdc.balanceOf(tenant), tnBal + (PROP_DEP - claimAmt) + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_acceptDamageClaim_fullAmount() public {
        uint256 id = _activateAgreement();
        _advanceToDamageClaimed(id, PROP_DEP); // claim entire deposit

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        vm.prank(tenant);
        escrow.acceptDamageClaim(id);

        // Landlord: full prop dep + hosting
        assertEq(usdc.balanceOf(landlord), llBal + PROP_DEP + MR);
        // Tenant: only commitment (no remainder)
        assertEq(usdc.balanceOf(tenant), tnBal + MR);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  8. DAMAGE CLAIM - TENANT NO RESPONSE TIMEOUT
    // ═════════════════════════════════════════════════════════════════════════════

    function test_executeExpiredClaim_autoExecutes() public {
        uint256 id = _activateAgreement();
        uint256 claimAmt = 3000e6;
        _advanceToDamageClaimed(id, claimAmt);

        // Warp past 3-day deadline without tenant responding
        vm.warp(block.timestamp + 3 days + 1);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        escrow.executeExpiredClaim(id);

        assertEq(usdc.balanceOf(landlord), llBal + claimAmt + MR);
        assertEq(usdc.balanceOf(tenant), tnBal + (PROP_DEP - claimAmt) + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_executeExpiredClaim_revert_tooEarly() public {
        uint256 id = _activateAgreement();
        _advanceToDamageClaimed(id, 3000e6);

        // Still within deadline
        vm.expectRevert("Deadline not passed");
        escrow.executeExpiredClaim(id);
    }

    function test_executeExpiredClaim_revert_tenantAlreadyResponded() public {
        uint256 id = _activateAgreement();
        _advanceToDamageClaimed(id, 3000e6);

        vm.prank(tenant);
        escrow.acceptDamageClaim(id);

        vm.warp(block.timestamp + 3 days + 1);
        vm.expectRevert("Wrong state"); // Already Settled
        escrow.executeExpiredClaim(id);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  9. DAMAGE CLAIM - DISPUTE + BOND
    // ═════════════════════════════════════════════════════════════════════════════

    function test_disputeDamageClaim() public {
        uint256 id = _activateAgreement();
        uint256 claimAmt = 3000e6;
        _advanceToDamageClaimed(id, claimAmt);

        vm.prank(tenant);
        escrow.disputeDamageClaim(id);

        assertTrue(escrow.getAgreement(id).tenantDisputedClaim);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DamageClaimed));
    }

    function test_disputeDamageClaim_revert_expired() public {
        uint256 id = _activateAgreement();
        _advanceToDamageClaimed(id, 3000e6);

        vm.warp(block.timestamp + 3 days + 1);

        vm.prank(tenant);
        vm.expectRevert("Response period expired");
        escrow.disputeDamageClaim(id);
    }

    function test_postDisputeBond_opensFreeze() public {
        uint256 id = _activateAgreement();
        uint256 claimAmt = 3000e6;
        _advanceToDamageClaimed(id, claimAmt);

        vm.prank(tenant);
        escrow.disputeDamageClaim(id);

        uint256 llBal = usdc.balanceOf(landlord);
        vm.prank(landlord);
        escrow.postDisputeBond(id);

        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(uint8(a.state), uint8(RentalEscrow.State.DisputeOpen));
        assertEq(a.disputeBond, claimAmt);
        assertEq(a.disputeBondPoster, landlord);
        assertGt(a.freezeStart, 0);
        assertEq(usdc.balanceOf(landlord), llBal - claimAmt);
    }

    function test_postDisputeBond_revert_notDisputed() public {
        uint256 id = _activateAgreement();
        _advanceToDamageClaimed(id, 3000e6);
        // Tenant has NOT disputed yet

        vm.prank(landlord);
        vm.expectRevert("Not disputed");
        escrow.postDisputeBond(id);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  10. BOND NOT POSTED - CLAIM DROPPED TIMEOUT
    // ═════════════════════════════════════════════════════════════════════════════

    function test_expireDamageClaim_claimDropped() public {
        uint256 id = _activateAgreement();
        uint256 claimAmt = 3000e6;
        _advanceToDamageClaimed(id, claimAmt);

        vm.prank(tenant);
        escrow.disputeDamageClaim(id);

        // Warp past claim deadline + bond posting period
        vm.warp(block.timestamp + 3 days + 3 days + 1);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        escrow.expireDamageClaim(id);

        // Tenant gets full prop deposit + commitment deposit
        assertEq(usdc.balanceOf(tenant), tnBal + PROP_DEP + MR);
        // Landlord gets hosting deposit back
        assertEq(usdc.balanceOf(landlord), llBal + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_expireDamageClaim_revert_bondWasPosted() public {
        uint256 id = _activateAgreement();
        uint256 claimAmt = 3000e6;
        _advanceToDamageClaimed(id, claimAmt);

        vm.prank(tenant);
        escrow.disputeDamageClaim(id);
        vm.prank(landlord);
        escrow.postDisputeBond(id);

        vm.warp(block.timestamp + 6 days + 1);
        vm.expectRevert("Wrong state"); // Already DisputeOpen
        escrow.expireDamageClaim(id);
    }

    function test_expireDamageClaim_revert_tooEarly() public {
        uint256 id = _activateAgreement();
        _advanceToDamageClaimed(id, 3000e6);

        vm.prank(tenant);
        escrow.disputeDamageClaim(id);

        // Only 4 days passed (need > 6 days total: 3 day deadline + 3 day bond period)
        vm.warp(block.timestamp + 4 days);
        vm.expectRevert("Bond period not expired");
        escrow.expireDamageClaim(id);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  11. DISPUTE - MUTUAL SETTLEMENT DURING FREEZE
    // ═════════════════════════════════════════════════════════════════════════════

    function _openDispute(uint256 id, uint256 claimAmt) internal {
        _advanceToDamageClaimed(id, claimAmt);
        vm.prank(tenant);
        escrow.disputeDamageClaim(id);
        vm.prank(landlord);
        escrow.postDisputeBond(id);
    }

    function test_mutualSettlement_during_freeze() public {
        uint256 id = _activateAgreement();
        uint256 claimAmt = 3000e6;
        _openDispute(id, claimAmt);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Settle: landlord gets 1000, tenant gets 4000 of prop deposit
        uint256 toLandlord = 1000e6;
        uint256 toTenant = PROP_DEP - toLandlord;

        // Tenant proposes settlement
        vm.prank(tenant);
        escrow.proposeMutualSettlement(id, toLandlord, toTenant);

        // Landlord confirms
        vm.prank(landlord);
        escrow.confirmMutualSettlement(id);

        // Bond returned to landlord + their share + hosting deposit
        assertEq(usdc.balanceOf(landlord), llBal + claimAmt + toLandlord + MR);
        // Tenant: their share + commitment deposit
        assertEq(usdc.balanceOf(tenant), tnBal + toTenant + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_mutualSettlement_revert_wrongAmounts() public {
        uint256 id = _activateAgreement();
        _openDispute(id, 3000e6);

        vm.prank(tenant);
        vm.expectRevert("Amounts must equal prop deposit");
        escrow.proposeMutualSettlement(id, 1000e6, 1000e6); // Doesn't sum to PROP_DEP
    }

    function test_mutualSettlement_revert_proposerCannotConfirm() public {
        uint256 id = _activateAgreement();
        _openDispute(id, 3000e6);

        vm.prank(tenant);
        escrow.proposeMutualSettlement(id, 1000e6, PROP_DEP - 1000e6);

        vm.prank(tenant);
        vm.expectRevert("Proposer cannot confirm");
        escrow.confirmMutualSettlement(id);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  12. DISPUTE - 60-DAY FREEZE EXPIRY
    // ═════════════════════════════════════════════════════════════════════════════

    function test_releaseFrozenFunds_after60Days() public {
        uint256 id = _activateAgreement();
        uint256 claimAmt = 3000e6;
        _openDispute(id, claimAmt);

        RentalEscrow.Agreement memory a = escrow.getAgreement(id);

        // Warp past freeze duration
        vm.warp(a.freezeStart + 60 days);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        escrow.releaseFrozenFunds(id);

        // Bond -> landlord, prop deposit -> tenant, commitment deposits -> each
        assertEq(usdc.balanceOf(landlord), llBal + claimAmt + MR);
        assertEq(usdc.balanceOf(tenant), tnBal + PROP_DEP + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_releaseFrozenFunds_revert_tooEarly() public {
        uint256 id = _activateAgreement();
        _openDispute(id, 3000e6);

        vm.warp(block.timestamp + 59 days);
        vm.expectRevert("Freeze not expired");
        escrow.releaseFrozenFunds(id);
    }

    function test_isFreezeExpired_view() public {
        uint256 id = _activateAgreement();
        _openDispute(id, 3000e6);

        assertFalse(escrow.isFreezeExpired(id));
        vm.warp(block.timestamp + 60 days);
        assertTrue(escrow.isFreezeExpired(id));
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  13. EARLY TERMINATION - MUTUAL EXIT
    // ═════════════════════════════════════════════════════════════════════════════

    function test_earlyTerm_mutual_success() public {
        uint256 id = _activateAgreement();

        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Mutual);

        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(uint8(a.state), uint8(RentalEscrow.State.EarlyTermProposed));
        assertEq(uint8(a.earlyTermType), uint8(RentalEscrow.TermType.Mutual));
        assertEq(a.earlyTermInitiator, tenant);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Counterparty signs
        vm.prank(landlord);
        escrow.signMutualExit(id);

        // Each gets their deposit back + tenant gets prop deposit
        assertEq(usdc.balanceOf(tenant), tnBal + MR + PROP_DEP);
        assertEq(usdc.balanceOf(landlord), llBal + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_earlyTerm_mutual_revert_initiatorSignsAgain() public {
        uint256 id = _activateAgreement();

        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Mutual);

        vm.prank(tenant);
        vm.expectRevert("Initiator already signed");
        escrow.signMutualExit(id);
    }

    function test_earlyTerm_mutual_revert_wrongType() public {
        uint256 id = _activateAgreement();

        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.InitiatorAccepts);

        vm.prank(landlord);
        vm.expectRevert("Not mutual type");
        escrow.signMutualExit(id);
    }

    function test_earlyTerm_mutual_noPropDep() public {
        uint256 id = _activateAgreementNoPropDep();

        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Mutual);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        vm.prank(tenant);
        escrow.signMutualExit(id);

        assertEq(usdc.balanceOf(tenant), tnBal + MR);
        assertEq(usdc.balanceOf(landlord), llBal + MR);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  14. EARLY TERMINATION - INITIATOR ACCEPTS LOSS
    // ═════════════════════════════════════════════════════════════════════════════

    function test_earlyTerm_tenantAcceptsLoss() public {
        uint256 id = _activateAgreement();

        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.InitiatorAccepts);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        vm.prank(tenant);
        escrow.executeInitiatorAcceptsLoss(id);

        // Tenant: loses commitment deposit, gets prop deposit back
        assertEq(usdc.balanceOf(tenant), tnBal + PROP_DEP);
        // Landlord: gets tenant's commitment deposit + own hosting deposit
        assertEq(usdc.balanceOf(landlord), llBal + MR + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_earlyTerm_landlordAcceptsLoss() public {
        uint256 id = _activateAgreement();

        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.InitiatorAccepts);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        vm.prank(landlord);
        escrow.executeInitiatorAcceptsLoss(id);

        // Tenant: gets hosting deposit + commitment deposit + prop deposit
        assertEq(usdc.balanceOf(tenant), tnBal + MR + MR + PROP_DEP);
        // Landlord: gets nothing
        assertEq(usdc.balanceOf(landlord), llBal);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_earlyTerm_acceptsLoss_revert_notInitiator() public {
        uint256 id = _activateAgreement();

        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.InitiatorAccepts);

        vm.prank(landlord); // Not the initiator
        vm.expectRevert("Only initiator can execute");
        escrow.executeInitiatorAcceptsLoss(id);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  15. EARLY TERMINATION - DISPUTED + BOND + FREEZE
    // ═════════════════════════════════════════════════════════════════════════════

    function test_earlyTerm_disputed_postBond_freeze_release() public {
        uint256 id = _activateAgreement();

        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Disputed);

        uint256 tnBal = usdc.balanceOf(tenant);

        vm.prank(tenant);
        escrow.postEarlyTermBond(id);

        // Bond = MR deducted from tenant
        assertEq(usdc.balanceOf(tenant), tnBal - MR);

        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(uint8(a.state), uint8(RentalEscrow.State.DisputeOpen));
        assertEq(a.disputeBond, MR);
        assertEq(a.disputeBondPoster, tenant);

        // Warp past freeze
        vm.warp(a.freezeStart + 60 days);

        tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        escrow.releaseFrozenFunds(id);

        // Bond -> tenant (poster), prop dep -> tenant, commitment deposits -> each
        assertEq(usdc.balanceOf(tenant), tnBal + MR + PROP_DEP + MR);
        assertEq(usdc.balanceOf(landlord), llBal + MR);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
    }

    function test_earlyTerm_disputed_revert_notInitiator() public {
        uint256 id = _activateAgreement();

        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Disputed);

        vm.prank(landlord); // Not the initiator
        vm.expectRevert("Only initiator posts bond");
        escrow.postEarlyTermBond(id);
    }

    function test_earlyTerm_landlordDisputed_bond_freeze_release() public {
        uint256 id = _activateAgreement();

        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Disputed);

        vm.prank(landlord);
        escrow.postEarlyTermBond(id);

        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(a.disputeBondPoster, landlord);

        vm.warp(a.freezeStart + 60 days);

        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        escrow.releaseFrozenFunds(id);

        // Bond -> landlord (poster), prop dep -> tenant, commitment deposits -> each
        assertEq(usdc.balanceOf(landlord), llBal + MR + MR); // bond + hosting
        assertEq(usdc.balanceOf(tenant), tnBal + PROP_DEP + MR); // prop dep + commitment
    }

    // ═════════════════════════════════════════════════════════════════════════════
