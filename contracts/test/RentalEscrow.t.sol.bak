    // ═════════════════════════════════════════════════════════════════════════════
    //  SCENARIO TESTS - All 6 Early Exit paths
    // ═════════════════════════════════════════════════════════════════════════════

    // Scenario 1: Voluntary Exit -> Accept Loss -> Settled
    function test_scenario_voluntary_acceptLoss() public {
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Tenant proposes voluntary exit (InitiatorAccepts)
        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.InitiatorAccepts);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.EarlyTermProposed));

        // Tenant executes loss - commitment deposit -> landlord
        vm.prank(tenant);
        escrow.executeInitiatorAcceptsLoss(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));

        // Landlord gets: commitment + hosting back
        assertEq(usdc.balanceOf(landlord), llBal + MR + MR);
        // Tenant gets: prop deposit back
        assertEq(usdc.balanceOf(tenant), tnBal + PROP_DEP);
    }

    // Scenario 2: Voluntary Exit -> Waive Claim -> Settled
    function test_scenario_voluntary_waiveClaim() public {
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Tenant proposes voluntary exit
        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.InitiatorAccepts);

        // Landlord waives - no penalty, deposits returned to each
        vm.prank(landlord);
        escrow.waiveInitiatorLoss(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));

        // Each gets own deposit back + tenant gets prop dep
        assertEq(usdc.balanceOf(tenant), tnBal + MR + PROP_DEP);
        assertEq(usdc.balanceOf(landlord), llBal + MR);
    }

    // Scenario 3: No Claim Exit -> Mutual Release -> Settled
    function test_scenario_noClaim_mutualRelease() public {
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Landlord proposes mutual exit
        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Mutual);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.EarlyTermProposed));

        // Tenant signs mutual exit
        vm.prank(tenant);
        escrow.signMutualExit(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));

        // Deposits returned to each
        assertEq(usdc.balanceOf(tenant), tnBal + MR + PROP_DEP);
        assertEq(usdc.balanceOf(landlord), llBal + MR);
    }

    // Scenario 4: No Claim Exit -> Contest & Post Bond -> DisputeOpen -> Release Frozen Funds -> Settled
    function test_scenario_noClaim_contestBond_release() public {
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Landlord proposes mutual exit
        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Mutual);

        // But wait - Mutual doesn't support postEarlyTermBond (only Disputed does).
        // For contest, counterparty would need to reject mutual and the proposer
        // would need to re-propose as Disputed. In current contract, Mutual only
        // supports signMutualExit. So this test verifies the timeout path instead:
        // Counterparty doesn't respond -> expireEarlyTermProposal after 7 days.
        vm.warp(block.timestamp + 7 days + 1);
        escrow.expireEarlyTermProposal(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));

        // Deposits returned
        assertEq(usdc.balanceOf(tenant), tnBal + MR + PROP_DEP);
        assertEq(usdc.balanceOf(landlord), llBal + MR);
    }

    // Scenario 4b: No Claim Exit -> Counterparty Contest -> DisputeOpen -> Release -> Settled
    function test_scenario_noClaim_counterpartyContest_release() public {
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Landlord proposes mutual exit
        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Mutual);

        // Tenant contests by posting bond
        vm.prank(tenant);
        escrow.counterpartyContest(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DisputeOpen));

        // After 60 days, release frozen funds
        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        vm.warp(a.freezeStart + a.freezeDuration);
        escrow.releaseFrozenFunds(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));

        // Tenant: commitment dep + prop dep + bond returned - bond paid = commitDep + propDep
        assertEq(usdc.balanceOf(tenant), tnBal + MR + PROP_DEP);
        // Landlord: hosting dep
        assertEq(usdc.balanceOf(landlord), llBal + MR);
    }

    // Scenario 4c: No Claim -> Contest -> Early Settlement (split all funds) -> Settled
    function test_scenario_noClaim_contest_earlySettlement() public {
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Landlord proposes mutual, tenant contests
        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Mutual);
        vm.prank(tenant);
        escrow.counterpartyContest(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DisputeOpen));

        // Total pool: commitDep(MR) + hostDep(MR) + propDep(PROP_DEP) + bond(MR)
        // But bond was paid by tenant so tnBal already decreased by MR
        uint256 totalPool = MR + MR + PROP_DEP + MR; // 12500e6

        // Tenant proposes: landlord gets 4000, tenant gets 8500
        uint256 toLl = 4000e6;
        uint256 toTn = totalPool - toLl;
        vm.prank(tenant);
        escrow.proposeEarlySettlement(id, toLl, toTn);

        // Landlord confirms
        vm.prank(landlord);
        escrow.confirmEarlySettlement(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));

        // Tenant: tnBal + toTn - bond(MR already deducted)
        assertEq(usdc.balanceOf(tenant), tnBal - MR + toTn);
        assertEq(usdc.balanceOf(landlord), llBal + toLl);
    }

    // Scenario 5: Dispute Exit -> Acknowledge Breach -> Settled
    function test_scenario_dispute_acknowledgeBreach() public {
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Landlord proposes disputed exit + posts bond
        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Disputed);

        vm.prank(landlord);
        escrow.postEarlyTermBond(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DisputeOpen));

        // After 60 days, funds released (no settlement reached = no acknowledgement on-chain)
        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        vm.warp(a.freezeStart + a.freezeDuration);
        escrow.releaseFrozenFunds(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));

        // Bond returned to landlord, prop dep to tenant, commitment deps to each
        // Note: landlord paid MR for bond, so balance was llBal - MR before release
        assertEq(usdc.balanceOf(tenant), tnBal + MR + PROP_DEP);
        assertEq(usdc.balanceOf(landlord), llBal + MR); // hosting returned + bond returned - bond paid = net +MR
    }

    // Scenario 6: Dispute Exit -> Propose Settlement -> Confirm Settlement -> Settled
    function test_scenario_dispute_proposeConfirmSettlement() public {
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Tenant proposes disputed exit + posts bond
        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Disputed);

        vm.prank(tenant);
        escrow.postEarlyTermBond(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DisputeOpen));

        // Tenant proposes settlement: 2000 to landlord, 3000 to tenant from prop dep
        uint256 toLl = 2000e6;
        uint256 toTn = PROP_DEP - toLl;
        vm.prank(tenant);
        escrow.proposeMutualSettlement(id, toLl, toTn);

        // Landlord confirms
        vm.prank(landlord);
        escrow.confirmMutualSettlement(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));

        // Tenant paid bond(MR) earlier, so net: bond returned + settlement share + commitDep - bond paid
        assertEq(usdc.balanceOf(tenant), tnBal + toTn + MR); // toTn + commitDep(returned) + bond(returned) - bond(paid) = toTn + MR
        // Landlord: settlement share + hosting dep
        assertEq(usdc.balanceOf(landlord), llBal + toLl + MR);
    }

    // Scenario 7: Dispute Exit -> Cancel Dispute -> Settled (bond returned, deposits each)
    function test_scenario_dispute_cancelByPoster() public {
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        // Tenant proposes disputed + posts bond
        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Disputed);
        vm.prank(tenant);
        escrow.postEarlyTermBond(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DisputeOpen));

        // Tenant cancels dispute
        vm.prank(tenant);
        escrow.cancelDisputeExit(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));

        // Penalty: initiator (tenant) loses deposit → landlord gets both commitment+hosting
        // Tenant gets: bond returned, but commitment deposit lost. Prop dep stays in escrow for review.
        assertEq(usdc.balanceOf(tenant), tnBal); // bond returned but commitment lost, propDep in escrow
        // Landlord gets: both deposits (commitment + hosting)
        assertEq(usdc.balanceOf(landlord), llBal + MR + MR);
        // Prop deposit still in escrow for PropDep review
        assertEq(usdc.balanceOf(address(escrow)), PROP_DEP);
    }

    // Scenario 8: Verify early exit already handles prop deposit
    function test_scenario_mutualExit_propDepositAlreadyReturned() public {
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);

        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Mutual);
        vm.prank(landlord);
        escrow.signMutualExit(id);

        // Prop deposit already returned to tenant by signMutualExit
        assertEq(usdc.balanceOf(tenant), tnBal + MR + PROP_DEP);
        assertEq(usdc.balanceOf(landlord), llBal + MR);
        assertEq(usdc.balanceOf(address(escrow)), 0);
    }

    // ═════════════════════════════════════════════════════════════════════════════
    //  FULL E2E SCENARIO - Step by step with assertions at every stage
    // ═════════════════════════════════════════════════════════════════════════════

    function test_e2e_voluntaryExit_acceptLoss() public {
        // Step 1: Create agreement
        uint256 id = escrow.createAgreement(tenant, landlord, MR, PROP_DEP, LEASE_MONTHS, CONTENT_HASH);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Created));
        console2.log("Step 1 PASS: Agreement created, state=Created");

        // Step 2: Tenant deposits (rent + commitment + propDep)
        vm.prank(tenant);
        escrow.tenantDeposit(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.AwaitingLandlordDep));
        console2.log("Step 2 PASS: Tenant deposited, state=AwaitingLandlordDep");

        // Step 3: Landlord deposits (hosting)
        vm.prank(landlord);
        escrow.landlordDeposit(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Active));
        console2.log("Step 3 PASS: Landlord deposited, state=Active");

        // Step 4: Verify balances after activation
        // First rent paid to landlord at activation
        uint256 tnAfterDeposit = usdc.balanceOf(tenant);
        uint256 llAfterDeposit = usdc.balanceOf(landlord);
        // Escrow holds: commitmentDep(MR) + hostingDep(MR) + propDep(PROP_DEP)
        assertEq(usdc.balanceOf(address(escrow)), MR + MR + PROP_DEP);
        console2.log("Step 4 PASS: Balances correct, escrow holds deposits");

        // Step 5: Tenant proposes Voluntary Exit (InitiatorAccepts)
        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.InitiatorAccepts);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.EarlyTermProposed));
        console2.log("Step 5 PASS: Tenant proposed Voluntary Exit, state=EarlyTermProposed");

        // Step 6: Verify earlyTermInitiator = tenant
        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(a.earlyTermInitiator, tenant);
        assertEq(uint8(a.earlyTermType), uint8(RentalEscrow.TermType.InitiatorAccepts));
        console2.log("Step 6 PASS: earlyTermInitiator=tenant, type=InitiatorAccepts");

        // Step 7: Tenant executes Accept Loss (initiator sends own deposit to counterparty)
        vm.prank(tenant);
        escrow.executeInitiatorAcceptsLoss(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
        console2.log("Step 7 PASS: executeInitiatorAcceptsLoss, state=Settled");

        // Step 8: Verify final balances
        // Tenant initiated -> commitment deposit goes to landlord
        // Landlord gets: commitmentDep(MR from tenant) + hostingDep(MR returned)
        assertEq(usdc.balanceOf(landlord), llAfterDeposit + MR + MR);
        // Tenant gets: propDep returned
        assertEq(usdc.balanceOf(tenant), tnAfterDeposit + PROP_DEP);
        // Escrow empty
        assertEq(usdc.balanceOf(address(escrow)), 0);
        console2.log("Step 8 PASS: Final balances correct, escrow=0");

        console2.log("===== E2E VOLUNTARY EXIT + ACCEPT LOSS: ALL STEPS PASS =====");
    }

    function test_e2e_voluntaryExit_waiveClaim() public {
        // Full flow: create -> deposits -> Active -> Voluntary Exit -> Waive Claim -> Settled
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Active));
        console2.log("Step 1 PASS: Agreement Active");

        vm.prank(tenant);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.InitiatorAccepts);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.EarlyTermProposed));
        console2.log("Step 2 PASS: Voluntary Exit proposed");

        // Landlord waives claim - no penalty
        vm.prank(landlord);
        escrow.waiveInitiatorLoss(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
        console2.log("Step 3 PASS: Landlord waived, state=Settled");

        // Each gets own deposit back
        assertEq(usdc.balanceOf(tenant), tnBal + MR + PROP_DEP);
        assertEq(usdc.balanceOf(landlord), llBal + MR);
        assertEq(usdc.balanceOf(address(escrow)), 0);
        console2.log("Step 4 PASS: Balances correct");
        console2.log("===== E2E VOLUNTARY EXIT + WAIVE CLAIM: ALL STEPS PASS =====");
    }

    function test_e2e_noClaimExit_contest_cancelBond() public {
        // Full flow: Active -> No Claim -> Contest Bond -> Cancel Bond -> Settled
        uint256 id = _activateAgreement();
        uint256 tnBal = usdc.balanceOf(tenant);
        uint256 llBal = usdc.balanceOf(landlord);
        console2.log("Step 1 PASS: Agreement Active");

        // Landlord proposes Mutual (No Claim)
        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Mutual);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.EarlyTermProposed));
        console2.log("Step 2 PASS: No Claim Exit proposed");

        // Tenant contests by posting bond
        vm.prank(tenant);
        escrow.counterpartyContest(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DisputeOpen));
        console2.log("Step 3 PASS: Tenant posted Bond, state=DisputeOpen");

        // Tenant cancels dispute - withdraws bond
        vm.prank(tenant);
        escrow.cancelDisputeExit(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
        console2.log("Step 4 PASS: Tenant cancelled, state=Settled");

        // Bond returned + deposits to each
        assertEq(usdc.balanceOf(tenant), tnBal + MR + PROP_DEP);
        assertEq(usdc.balanceOf(landlord), llBal + MR);
        assertEq(usdc.balanceOf(address(escrow)), 0);
        console2.log("Step 5 PASS: Balances correct");
        console2.log("===== E2E NO CLAIM + CONTEST + CANCEL: ALL STEPS PASS =====");
    }

