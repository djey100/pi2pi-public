        vm.prank(landlord);
        escrow.concedeDispute(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
        // Landlord conceded -> hosting dep goes to tenant. Bond returned to tenant.
        assertEq(usdc.balanceOf(tenant), tnBal + MR + MR + PROP_DEP); // commitDep+hostDep+propDep (bond net zero)
        assertEq(usdc.balanceOf(landlord), llBal); // nothing returned
        console2.log("SYMMETRY A: PASS - LL No Claim -> TN Contest -> LL Concede");
    }

