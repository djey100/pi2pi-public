    // E2E: Landlord file claim -> Landlord withdraw
    function test_e2e_damageClaim_withdraw() public {
        uint256 id = _activateAgreement();
        _advanceToCheckout(id);
        uint256 tnBal = usdc.balanceOf(tenant);

        vm.prank(landlord);
        escrow.fileDamageClaim(id, 2000e6);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DamageClaimed));
        console2.log("Step 1 PASS: Claim filed");

        vm.prank(landlord);
        escrow.withdrawDamageClaim(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
        // Tenant gets prop deposit back + commitment dep (from _settleClean-like behavior)
        // Note: withdrawDamageClaim only returns prop deposit, commitment deps returned by checkout/settle
        console2.log("Step 2 PASS: Claim withdrawn, Settled");
        // Prop deposit returned to tenant (commitment deps already returned by checkout)
        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(a.propSecurityDeposit, 0); // zeroed
        assertEq(a.damageClaim, 0); // zeroed
        console2.log("Step 3 PASS: propDep=0, damageClaim=0");
        console2.log("===== DAMAGE CLAIM + WITHDRAW: PASS =====");
    }

