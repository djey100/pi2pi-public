        escrow.releaseFrozenFunds(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
        assertEq(usdc.balanceOf(address(escrow)), 0);
        console2.log("SYMMETRY E: PASS - LL Claim -> Bond -> Release");
    }

