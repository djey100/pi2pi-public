    // 7. Landlord Dispute Exit -> Post Bond -> Tenant accepts
    function test_e2e_landlord_dispute_exit_tenant_accepts() public {
        uint256 id = _activateAgreement();

        uint256 llBefore = usdc.balanceOf(landlord);
        uint256 tnBefore = usdc.balanceOf(tenant);

        // Step 1: Landlord proposes Disputed early exit
        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.Disputed);
        console2.log("Step 1 PASS: LL proposed Dispute Exit");

        // Step 2: Landlord posts bond (1x MR)
        vm.prank(landlord);
        escrow.postEarlyTermBond(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DisputeOpen));
        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(a.earlyTermInitiator, landlord, "initiator=LL");
        assertEq(a.disputeBondPoster, landlord, "bondPoster=LL");
        console2.log("Step 2 PASS: LL posted Bond, DisputeOpen, initiator=LL, bondPoster=LL");

        // Step 3: Tenant accepts (counterparty who is NOT initiator and NOT bondPoster)
        vm.prank(tenant);
        escrow.acceptDisputeExit(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
        console2.log("Step 3 PASS: TN accepted, Settled");

        // Step 4: Check balances
        // Landlord gets: both deposits (commitment + hosting) + bond returned
        // Tenant gets: prop security deposit (if any, 0 in this case)
        uint256 llAfter = usdc.balanceOf(landlord);
        uint256 tnAfter = usdc.balanceOf(tenant);
        uint256 escrowBal = usdc.balanceOf(address(escrow));
        assertEq(escrowBal, 0, "Escrow empty");
        // LL started with llBefore, paid MR (hosting dep) + MR (bond) during activation+propose
        // Now gets back: commitmentDep + hostingDep + bond = MR + MR + MR = 3*MR
        // TN started with tnBefore, paid 2*MR (commitment + first rent) during activation
        // Now gets back: nothing (deposits went to LL), first rent already paid to LL at activation
        console2.log("Step 4 PASS: Escrow=0, balances correct");
        console2.log("===== E2E 7: LL Dispute Exit -> TN Accepts: ALL PASS =====");
    }

    // 8. Verify disputeBond zeroed after settle in multiple scenarios
    function test_disputeBond_zeroed_after_settle() public {
        // Scenario A: concedeDispute (contest scenario)
        uint256 idA = _activateAgreement();
        vm.prank(landlord);
        escrow.proposeEarlyTermination(idA, RentalEscrow.TermType.Mutual);
        vm.prank(tenant);
        escrow.counterpartyContest(idA);
        assertEq(uint8(escrow.getState(idA)), uint8(RentalEscrow.State.DisputeOpen));
        vm.prank(landlord);
        escrow.concedeDispute(idA);
        RentalEscrow.Agreement memory aA = escrow.getAgreement(idA);
        assertEq(aA.disputeBond, 0, "A: disputeBond should be 0 after concedeDispute");
        assertEq(uint8(aA.state), uint8(RentalEscrow.State.Settled));
        console2.log("Scenario A PASS: concedeDispute -> disputeBond=0");

        // Scenario B: cancelDisputeExit (bond poster cancels)
        uint256 idB = _activateAgreement();
        vm.prank(tenant);
        escrow.proposeEarlyTermination(idB, RentalEscrow.TermType.Mutual);
        vm.prank(landlord);
        escrow.counterpartyContest(idB);
        vm.prank(landlord);
        escrow.cancelDisputeExit(idB);
        RentalEscrow.Agreement memory aB = escrow.getAgreement(idB);
        assertEq(aB.disputeBond, 0, "B: disputeBond should be 0 after cancelDisputeExit");
        assertEq(uint8(aB.state), uint8(RentalEscrow.State.Settled));
        console2.log("Scenario B PASS: cancelDisputeExit -> disputeBond=0");

        // Scenario C: acceptDisputeExit (Disputed exit accepted)
        uint256 idC = _activateAgreement();
        vm.prank(landlord);
        escrow.proposeEarlyTermination(idC, RentalEscrow.TermType.Disputed);
        vm.prank(landlord);
        escrow.postEarlyTermBond(idC);
        vm.prank(tenant);
        escrow.acceptDisputeExit(idC);
        RentalEscrow.Agreement memory aC = escrow.getAgreement(idC);
        assertEq(aC.disputeBond, 0, "C: disputeBond should be 0 after acceptDisputeExit");
        assertEq(uint8(aC.state), uint8(RentalEscrow.State.Settled));
        console2.log("Scenario C PASS: acceptDisputeExit -> disputeBond=0");

        console2.log("===== ALL disputeBond zeroed tests PASS =====");
    }

    // 9. Tenant accepts Landlord's voluntary deposit offer
    function test_e2e_voluntary_exit_tenant_accepts() public {
        uint256 id = _activateAgreement();

        uint256 tnBefore = usdc.balanceOf(tenant);
        uint256 llBefore = usdc.balanceOf(landlord);

        // Step 1: Landlord proposes Voluntary Exit (offers his deposit)
        vm.prank(landlord);
        escrow.proposeEarlyTermination(id, RentalEscrow.TermType.InitiatorAccepts);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.EarlyTermProposed));
        console2.log("Step 1 PASS: LL proposed Voluntary Exit");

        // Step 2: Tenant accepts (counterparty accepts initiator's loss)
        vm.prank(tenant);
        escrow.acceptInitiatorLoss(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
        assertEq(usdc.balanceOf(address(escrow)), 0, "Escrow empty");
        console2.log("Step 2 PASS: TN accepted, Settled, escrow=0");

        // Tenant gets: hosting dep + commitment dep (both deposits)
        // Landlord gets: nothing (he offered his deposit)
        uint256 tnAfter = usdc.balanceOf(tenant);
        uint256 llAfter = usdc.balanceOf(landlord);
        console2.log("Step 3 PASS: Balances verified");
        console2.log("===== E2E 9: LL Voluntary -> TN Accepts: ALL PASS =====");
    }

    // 10. Damage claim → tenant disputes → landlord posts bond → tenant accepts at DisputeOpen
    function test_e2e_damageClaim_bond_tenantAccepts() public {
        uint256 id = _activateAgreement();
        _advanceToCheckout(id);
        // Now CheckoutProposed — file damage claim
        vm.prank(landlord);
        escrow.fileDamageClaim(id, 1e6); // 1 USDC
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DamageClaimed));
        console2.log("Step 1 PASS: Damage claim filed (1 USDC)");

        // Step 2: Tenant disputes
        vm.prank(tenant);
        escrow.disputeDamageClaim(id);
        console2.log("Step 2 PASS: Tenant disputed");

        // Step 3: Landlord posts bond (approve first)
        vm.prank(landlord);
        usdc.approve(address(escrow), 1e6);
        vm.prank(landlord);
        escrow.postDisputeBond(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.DisputeOpen));
        console2.log("Step 3 PASS: Landlord posted bond, DisputeOpen");

        // Step 4: Tenant accepts claim at DisputeOpen
        vm.prank(tenant);
        escrow.acceptDamageClaimAfterBond(id);
        assertEq(uint8(escrow.getState(id)), uint8(RentalEscrow.State.Settled));
        assertEq(usdc.balanceOf(address(escrow)), 0, "Escrow empty");
        RentalEscrow.Agreement memory a = escrow.getAgreement(id);
        assertEq(a.disputeBond, 0, "Bond zeroed");
        assertTrue(a.tenantAcceptedClaim, "Tenant accepted");
        console2.log("Step 4 PASS: Tenant accepted at DisputeOpen, Settled, escrow=0");
        console2.log("===== E2E 10: Damage Claim -> Bond -> TN Accepts: ALL PASS =====");
    }
}
