# pi2pi — environment variable reference
#
# Copy this file to .env (or set as Fly/CI secrets) and fill in real values.
# NEVER commit a real .env file or a real secret value.
# All values below are placeholders — none are functional.

# ─────────────────────────────────────────────────────────────────────────
# FRONTEND — build-time only (arc/.env.production, arc/.env.development, arc/.env.test)
# Non-secret. Baked into the built bundle at `vite build` time.
# ─────────────────────────────────────────────────────────────────────────
VITE_NETWORK=arc-testnet   # exactly "arc-testnet" or "arc-mainnet"

# ─────────────────────────────────────────────────────────────────────────
# BACKEND (server-arc.js, admin_routes.js, auth.js) — REQUIRED
# ─────────────────────────────────────────────────────────────────────────
NETWORK=arc-testnet                          # exactly "arc-testnet" or "arc-mainnet" — fails closed if unset/unrecognized
RPC_URL=https://rpc.testnet.arc.network       # official Arc RPC for the chosen network
APP_BASE_URL=https://testnet.pi2pi.io         # this deployment's own public URL — used for CORS/WebAuthn/email links, never a shared/other-network domain

# Supabase (single project shared across networks)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Pinata / IPFS (document + photo storage)
PINATA_JWT=

# Admin panel session signing (long random string, e.g. `openssl rand -hex 48`)
ADMIN_SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# BACKEND — optional / feature-gated
# ─────────────────────────────────────────────────────────────────────────
REQUIRE_WALLET_AUTH=true        # "true"/"false" — enforce wallet-session auth on mutating endpoints
ENABLE_ACCOUNT_RESET=false      # "true" to enable the dev/test account-reset endpoint

# Contract addresses — optional override; falls back to config/deployments.json's
# entry for the active chain ID if unset
RENTAL_ESCROW_ADDRESS=
PROPDEP_ESCROW_ADDRESS=

# Admin "Time Travel" (virtual clock) — Arc Testnet only, hard-blocked on any
# other chain regardless of this value. Never set on a Mainnet deployment.
ALLOW_ADMIN_TIME_TRAVEL=false
DEPLOYER_PRIVATE_KEY=            # only relevant alongside ALLOW_ADMIN_TIME_TRAVEL; a Testnet-only dev key, never a funded/production key

# World ID personhood verification (optional integration)
WORLDCOIN_APP_ID=
WORLDCOIN_RP_ID=

# Telegram notifications (optional integration)
TELEGRAM_BOT_TOKEN=

# Email notifications via Resend (optional integration)
RESEND_API_KEY=
EMAIL_FROM="pi2pi <noreply@pi2pi.io>"
EMAIL_SECRET=                    # signs confirm/unsubscribe email links; falls back to ADMIN_SESSION_SECRET if unset

# Keeper heartbeat receiver (optional — backend side; must match the keeper's own KEEPER_HEARTBEAT_SECRET below)
KEEPER_HEARTBEAT_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# KEEPER (keeper/enforcer.ts) — REQUIRED
# ─────────────────────────────────────────────────────────────────────────
NETWORK=arc-testnet
RPC_URL=https://rpc.testnet.arc.network
ESCROW_ADDRESS=                  # RentalEscrow address for this network — never reuse another network's address
PROPDEP_ADDRESS=                 # PropDepEscrow address for this network
KEEPER_PRIVATE_KEY=              # dedicated signer key for this keeper instance — never reused across networks
DRY_RUN=true                     # "true" or "false" only, no default — mandatory explicit value; keep "true" until verified safe to enable writes

# ─────────────────────────────────────────────────────────────────────────
# KEEPER — optional
# ─────────────────────────────────────────────────────────────────────────
LOOP_INTERVAL=15                 # seconds between scans; 0 = run once and exit
BATCH_SIZE=100                   # max agreements scanned per cycle
HEARTBEAT_URL=                   # this network's own backend base URL (e.g. https://testnet.pi2pi.io) — must match the network above, never a different network's domain
KEEPER_HEARTBEAT_SECRET=         # must match the receiving backend's own KEEPER_HEARTBEAT_SECRET
MEMO_BASELINE_JSON=              # optional JSON map to pre-seed rent-payment Memo baselines, e.g. {"0":1,"1":3}
